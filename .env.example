# ---------------------------------------------------------------------------
# 知衡 FinScope 环境变量示例
# 复制本文件为 .env 即可本地运行（mock 模式下无需任何 API Key）
# ---------------------------------------------------------------------------

# 数据库：SQLite 单文件。相对路径以 prisma/schema.prisma 所在目录为基准。
DATABASE_URL="file:./dev.db"

# LLM 模式：llm | mock
#   llm  = 配置了 BASE_URL + API_KEY + MODEL 时走多智能体；失败自动降级
#   mock = 不调用 LLM，只走确定性智能体（仍会真实拉行情、跑量化）
LLM_MODE="llm"

# OpenAI 兼容接口（DeepSeek / 通义千问 / 任意兼容服务）
LLM_BASE_URL="https://api.deepseek.com"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"

# 视觉模型（可选；用于 K 线截图/财报图片/持仓截图）
LLM_VISION_BASE_URL=""
LLM_VISION_API_KEY=""
LLM_VISION_MODEL=""

# 单次调用超时（毫秒），超时后自动降级
LLM_TIMEOUT_MS="90000"

# Python 量化服务
QUANT_SERVICE_URL="http://127.0.0.1:8000"
QUANT_PORT="8000"
ALLOW_LIVE_DATA="true"

# 站点名称（展示用）
NEXT_PUBLIC_SITE_NAME="知衡 FinScope"
